# Copy to .env for running on your machine: `cp .env.example .env`
# Every variable here is read by app/core/env.py.

PROJECT_NAME="RAG QA API"
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Per-API limits live in app/core/rate_limiting.py; this only switches them on/off.
RATE_LIMIT_ENABLED=true

# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

MAX_UPLOAD_BYTES=10485760

# Local models (fastembed, CPU). Downloaded on first start into MODEL_CACHE_DIR.
# Changing EMBEDDING_MODEL to one that isn't 384-dimensional needs a migration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=.cache/models

CHUNK_STRATEGY=recursive     # fixed | recursive | semantic
CHUNK_SIZE=800               # characters
CHUNK_OVERLAP=120

RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
MIN_RERANK_SCORE=-4.0

# Without a key the API still runs; /ask returns 503 and /search works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium            # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
